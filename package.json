{
	"name": "github-pm-reminders",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"deploy": "wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply github-pm-reminders-db --local",
		"db:migrate:prod": "wrangler d1 migrations apply github-pm-reminders-db --remote",
		"db:seed:local": "node scripts/seed-dev.mjs",
		"db:seed:reset": "node scripts/seed-dev.mjs --reset",
		"check:oauth": "node scripts/check-oauth.mjs",
		"spike:board": "node scripts/spike-board.mjs"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.77.0",
		"@sveltejs/adapter-cloudflare": "^4.7.0",
		"@sveltejs/kit": "^2.7.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.7.0",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"svelte": "^5.1.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.6.0",
		"vite": "^5.4.0",
		"vitest": "^3.2.7",
		"wrangler": "^3.83.0"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"mode-watcher": "^1.1.0"
	}
}
