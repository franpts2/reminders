# Local development values for `npm run dev`.
# Copy this file to `.dev.vars` and fill in the values. `.dev.vars` is gitignored.
# These override the [vars] in wrangler.toml while running locally.
#
# The callback URL registered on the GitHub OAuth app must be
# `${APP_URL}/auth/callback` (e.g. http://localhost:5173/auth/callback).
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
APP_URL=http://localhost:5173
#
# Board probe (npm run spike:board). Optional; only needed to inspect a
# GitHub Projects v2 board. The token needs read:project.
# BOARD_URL=https://github.com/orgs/your-org/projects/1
# GITHUB_TOKEN=
#
# Feature flags. Set to 1 to show the sprint board card in project settings.
# BOARD_METRICS=1
